{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --config.dangerouslyAllowAllBuilds=true",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/health/(.*)", "destination": "/api/index" },
    { "source": "/((?!assets/|manifest\\.webmanifest|icon\\.svg|sw\\.js|robots\\.txt|sitemap\\.xml|llms\\.txt).*)", "destination": "/index.html" }
  ]
}
