{
  "name": "khata-saathi",
  "version": "1.0.0",
  "private": true,
  "description": "Voice/text udhaar-khata ledger assistant for small shopkeepers in Pakistan",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @khata-saathi/api --filter @khata-saathi/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @khata-saathi/core test && pnpm --filter @khata-saathi/api test",
    "test:e2e": "playwright test",
    "start": "pnpm --filter @khata-saathi/api start"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
